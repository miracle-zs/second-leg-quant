[Unit]
Description=AI Coin Selector candidate refresh
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/ai-coin-selector/.env

[Service]
Type=oneshot
User=ai-coin-selector
WorkingDirectory=/opt/ai-coin-selector
Environment=COIN_DATABASE=/opt/ai-coin-selector/runs/account.sqlite3
ExecStart=/usr/bin/python3 scripts/scan_second_leg_pool.py
UMask=0027
