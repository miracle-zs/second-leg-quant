# ==============================================================================
# 突破追多与移动保本系统 · 统一配置与密钥模板 (.env.example)
# 使用说明: 复制本文件为 .env 并填入个人密钥: cp .env.example .env
# ==============================================================================

# 1. CoinMarketCap 官方 Pro API Key (用于标的真实流通市值权威核验)
CMC_API_KEY=your_cmc_pro_api_key_here

# 2. Server酱微信通知 SendKey (用于新币进入共振区 / 15m突破开多 / 跌破止损 / +6%保本预警)
SERVERCHAN_SENDKEY=your_serverchan_sendkey_here

# 3. 币安合约 API (用于实盘多头持仓自动对齐与风控守护；留空则为纯模拟/日志模式)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# 4. SQLite 数据库路径 (留空或注释则默认使用项目目录下 runs/account.sqlite3)
# COIN_DATABASE=/opt/ai-coin-selector/runs/account.sqlite3

# 5. 交易与风控高级参数 (带内置默认值，按需微调)
TRADINGVIEW_LAYOUT_ID=ig0LuDL8
TRAILING_ACTIVATION_PCT=6.0
TRAILING_LOCK_PCT=1.0
